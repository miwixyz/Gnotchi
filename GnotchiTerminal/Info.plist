<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Gnotchi Terminal</string>
	<key>CFBundleDisplayName</key>
	<string>Gnotchi Terminal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- Terminalfenster (docs/SECURE-DESIGN.md G65): echte Shell mit Nutzerrechten, eigene Kennung, KEINE Berechtigungen
	     (Entitlements). Ordnerzugriffe fragt macOS unter diesem Namen ab, nicht unter Gnotchi; die Texte erklären, wer fragt. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Ein Programm in diesem Terminal möchte auf deinen Schreibtisch zugreifen.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Ein Programm in diesem Terminal möchte auf deine Dokumente zugreifen.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Ein Programm in diesem Terminal möchte auf deine Downloads zugreifen.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Ein Programm in diesem Terminal möchte auf ein externes Laufwerk zugreifen.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Ein Programm in diesem Terminal möchte auf ein Netzlaufwerk zugreifen.</string>
	<!-- Bewusst KEIN URL-Schema, kein AppleScript-Empfang, keine Dienste (wie Gnotchi, G13). -->
</dict>
</plist>
