{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Gnotchi",
  "Version": "0.42.0.0",
  "Author": "MWLR",
  "Description": "Lautstärke, Wiedergabe und Lautsprecher je App über Gnotchi: Spotify, Musik, Safari, Helium, Edge, Teams. Dazu Ausgabe und Mikrofon des Macs.",
  "URL": "https://github.com/miwixyz/Gnotchi",
  "UUID": "dev.mwlr.gnotchi.deck",
  "Icon": "imgs/plugin",
  "CodePath": "gnotchideck",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.5" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "27" }],
  "Category": "Gnotchi",
  "CategoryIcon": "imgs/category",
  "PropertyInspectorPath": "pi/index.html",
  "Profiles": [
    { "Name": "profiles/gnotchi-plus", "DeviceType": 7, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true },
    { "Name": "profiles/gnotchi-neo", "DeviceType": 9, "Readonly": false, "DontAutoSwitchWhenInstalled": true, "AutoInstall": true }
  ],
  "Actions": [
    {
      "Name": "App-Lautstärke",
      "UUID": "dev.mwlr.gnotchi.deck.volume",
      "Icon": "imgs/volume",
      "Tooltip": "Lautstärke einer App, Titel auf der Leiste",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/volume-dial",
        "layout": "layouts/volume.json",
        "TriggerDescription": { "Rotate": "Lautstärke · gedrückt: Titel", "Push": "Stumm", "Touch": "Play/Pause" }
      },
      "States": [{ "Image": "imgs/key-volume", "TitleAlignment": "top", "FontSize": 10 }]
    },
    {
      "Name": "App-Lautsprecher",
      "UUID": "dev.mwlr.gnotchi.deck.output",
      "Icon": "imgs/output",
      "Tooltip": "Auf welchem Gerät eine App spielt",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/output-dial",
        "layout": "layouts/volume.json",
        "TriggerDescription": { "Rotate": "Gerät wählen", "Push": "Übernehmen", "Touch": "Eigenes Gerät" }
      },
      "States": [{ "Image": "imgs/key-output", "TitleAlignment": "top", "FontSize": 10 }]
    },
    {
      "Name": "Ausgabe",
      "UUID": "dev.mwlr.gnotchi.deck.system-output",
      "Icon": "imgs/sysout",
      "Tooltip": "Ausgabegerät des Macs, z. B. AirPods",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/sysout-dial",
        "layout": "layouts/volume.json",
        "TriggerDescription": { "Rotate": "Gerät wählen", "Push": "Übernehmen", "Touch": "Festes Gerät" }
      },
      "States": [{ "Image": "imgs/key-sysout", "TitleAlignment": "top", "FontSize": 10 }]
    },
    {
      "Name": "Mikrofon",
      "UUID": "dev.mwlr.gnotchi.deck.system-input",
      "Icon": "imgs/sysin",
      "Tooltip": "Mikrofon des Macs, z. B. AirPods",
      "Controllers": ["Encoder", "Keypad"],
      "Encoder": {
        "Icon": "imgs/sysin-dial",
        "layout": "layouts/volume.json",
        "TriggerDescription": { "Rotate": "Gerät wählen", "Push": "Übernehmen", "Touch": "Festes Gerät" }
      },
      "States": [{ "Image": "imgs/key-sysin", "TitleAlignment": "top", "FontSize": 10 }]
    },
    {
      "Name": "Wiedergabe",
      "UUID": "dev.mwlr.gnotchi.deck.play",
      "Icon": "imgs/play",
      "Tooltip": "Play/Pause, Weiter oder Zurück für eine App",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/key-play", "TitleAlignment": "top", "FontSize": 10 }]
    }
  ]
}
